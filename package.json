{
  "name":"winmux",
  "version":"0.1.0",
  "private":true,
  "description":"A Windows terminal workspace for AI CLI agents",
  "main":"electron/main.cjs",
  "scripts":{
    "dev":"node scripts/dev.cjs",
    "build":"tsc --noEmit && vite build",
    "start":"electron .",
    "test:backend":"node scripts/run-electron-node.cjs tests/backend-smoke.cjs",
    "test:desktop":"node tests/desktop-smoke.cjs",
    "cli":"node scripts/run-electron-node.cjs cli.cjs",
    "rebuild":"electron-rebuild -f -w node-pty",
    "package":"npm run build && electron-builder --dir"
  },
  "dependencies":{
    "@xterm/xterm":"6.0.0",
    "@xterm/headless":"6.0.0",
    "@xterm/addon-serialize":"0.14.0",
    "@xterm/addon-fit":"^0.11.0",
    "@xterm/addon-search":"^0.16.0",
    "@xterm/addon-web-links":"^0.12.0",
    "lucide-react":"^0.468.0",
    "node-pty":"1.1.0",
    "react":"^19.2.0",
    "react-dom":"^19.2.0"
  },
  "devDependencies":{
    "@electron/rebuild":"^4.0.0",
    "@types/node":"^24.0.0",
    "@types/react":"^19.2.0",
    "@types/react-dom":"^19.2.0",
    "@vitejs/plugin-react":"^5.1.0",
    "electron":"45.3.2",
    "electron-builder":"^26.0.12",
    "playwright":"^1.56.0",
    "typescript":"^5.9.0",
    "vite":"^7.2.0"
  },
  "build":{
    "appId":"local.winmux.desktop",
    "productName":"Winmux",
    "directories":{"output":"release"},
    "files":["dist/**/*","electron/**/*","cli.cjs","package.json"],
    "asarUnpack":["node_modules/node-pty/**/*"],
    "win":{"target":"dir"}
  }
}
