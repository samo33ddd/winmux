{
  "name":"winmux",
  "version":"0.2.1",
  "private":true,
  "description":"A Windows terminal workspace for AI CLI agents",
  "main":"electron/main.cjs",
  "scripts":{
    "dev":"node scripts/dev.cjs",
    "build":"tsc --noEmit && vite build",
    "start":"electron .",
    "test:backend":"node scripts/run-electron-node.cjs tests/backend-smoke.cjs",
    "test:desktop":"node tests/desktop-smoke.cjs",
    "test:cwd-agent":"node scripts/run-electron-node.cjs tests/cwd-agent-smoke.cjs",
    "test:profile":"node tests/powershell-profile-smoke.cjs",
    "test:skills":"node --test tests/skills-install-smoke.cjs",
    "test:integrations":"node --test tests/codex-daemon-smoke.cjs tests/codex-mapping.cjs tests/terminal-tab-label.cjs tests/terminal-theme-smoke.cjs tests/agent-hooks-install-smoke.cjs && node scripts/run-electron-node.cjs tests/codex-controller-smoke.cjs && node scripts/run-electron-node.cjs tests/title-mode-smoke.cjs",
    "test:cookies":"node tests/cookie-import-smoke.cjs",
    "test:workspace":"node tests/workspace-smoke.cjs",
    "test:file-preview":"node --test tests/local-file-links.cjs && node tests/file-preview-smoke.cjs",
    "browser":"node scripts/browser.cjs",
    "cli":"node scripts/run-electron-node.cjs cli.cjs",
    "rebuild":"electron-rebuild -f -w node-pty",
    "package":"npm run build && electron-builder --dir",
    "release:build":"npm run build && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies":{
    "ws":"8.23.0",
    "@xterm/xterm":"6.0.0",
    "@xterm/headless":"6.0.0",
    "@xterm/addon-serialize":"0.14.0",
    "@xterm/addon-fit":"^0.11.0",
    "@xterm/addon-search":"^0.16.0",
    "@xterm/addon-web-links":"^0.12.0",
    "lucide-react":"^0.468.0",
    "node-pty":"1.1.0",
    "react":"^19.2.0",
    "react-dom":"^19.2.0"
  },
  "devDependencies":{
    "@electron/rebuild":"^4.0.0",
    "@types/node":"^24.0.0",
    "@types/react":"^19.2.0",
    "@types/react-dom":"^19.2.0",
    "@vitejs/plugin-react":"^5.1.0",
    "electron":"45.3.2",
    "electron-builder":"^26.0.12",
    "playwright":"^1.56.0",
    "typescript":"^5.9.0",
    "vite":"^7.2.0"
  },
  "build":{
    "appId":"io.github.samo33ddd.winmux",
    "productName":"Winmux",
    "directories":{"output":"release"},
    "files":["dist/**/*","electron/**/*","cli.cjs","scripts/browser.cjs","skills/**/*","build/icon.png","package.json"],
    "asarUnpack":["node_modules/node-pty/**/*"],
    "extraResources":[{"from":"build/icon.ico","to":"icon.ico"}],
    "npmRebuild":false,
    "win":{"target":["nsis","portable"],"icon":"build/icon.ico"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"perMachine":false,"artifactName":"Winmux-Setup-${version}-${arch}.${ext}"},
    "portable":{"artifactName":"Winmux-Portable-${version}-${arch}.${ext}"}
  }
}
